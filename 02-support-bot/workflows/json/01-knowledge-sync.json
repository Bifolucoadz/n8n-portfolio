[{"updatedAt":"2026-10-01T15:02:17.375Z","createdAt":"2026-10-01T14:27:57.525Z","id":"qflC4MXxlxqI8LfQ","name":"Support Bot 1: Knowledge Sync","description":"Re-indexes the Copperline shop info Google Doc into the Supabase vector store when it changes: export as Markdown, guard against an emptied doc, insert new chunks, then remove the old version's chunks.","active":true,"isArchived":false,"nodes":[{"id":"ecd05a8a-12d2-425a-bc4b-e171a5f483f2","name":"Shop Info Doc Updated","type":"n8n-nodes-base.googleDriveTrigger","typeVersion":1,"position":[240,240],"parameters":{"pollTimes":{"item":[{"mode":"everyX","value":5,"unit":"minutes"}]},"triggerOn":"specificFile","fileToWatch":{"__rl":true,"mode":"id","value":"1By8r-Hifea1hwlsW_M7oAkfqtUtnteXsqffg7B6w1Ow"},"event":"fileUpdated"},"credentials":{"googleDriveOAuth2Api":{"id":"sN9bbP0t0u0A88QU","name":"Google Drive account"}}},{"id":"a9be3f33-bfd0-44f8-9027-0af6ab796305","name":"Config","type":"n8n-nodes-base.set","typeVersion":3.4,"position":[480,340],"parameters":{"mode":"manual","includeOtherFields":false,"assignments":{"assignments":[{"id":"file-id","name":"FILE_ID","value":"1By8r-Hifea1hwlsW_M7oAkfqtUtnteXsqffg7B6w1Ow","type":"string"},{"id":"file-name","name":"FILE_NAME","value":"Copperline Auto Repair: Shop Info","type":"string"},{"id":"min-chars","name":"MIN_CHARS","value":500,"type":"number"},{"id":"version","name":"VERSION","value":"={{ $now.toUTC().toISO() }}","type":"string"}]}},"executeOnce":true},{"id":"e54f50ea-f3ba-4fb5-81b9-1b8c4c34d454","name":"Rebuild Now","type":"n8n-nodes-base.manualTrigger","typeVersion":1,"position":[240,440],"parameters":{}},{"id":"7ebd6b35-0871-4725-aacb-780c18dff17f","name":"Export Doc as Markdown","type":"n8n-nodes-base.httpRequest","typeVersion":4.4,"position":[720,340],"parameters":{"method":"GET","url":"=https://www.googleapis.com/drive/v3/files/{{ $json.FILE_ID }}/export?mimeType=text/markdown","authentication":"predefinedCredentialType","nodeCredentialType":"googleDriveOAuth2Api","options":{"response":{"response":{"responseFormat":"text","outputPropertyName":"text"}}}},"credentials":{"googleDriveOAuth2Api":{"id":"sN9bbP0t0u0A88QU","name":"Google Drive account"}},"retryOnFail":true,"maxTries":3,"waitBetweenTries":5000},{"id":"06678c91-b8e8-4a04-836f-ed0b4b5a3350","name":"Doc Has Content?","type":"n8n-nodes-base.if","typeVersion":2.3,"position":[960,340],"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"leftValue":"={{ ($json.text ?? \"\").trim().length }}","rightValue":"={{ $('Config').item.json.MIN_CHARS }}","operator":{"type":"number","operation":"gte"}}],"combinator":"and"}}},{"id":"a4406fad-6659-4581-821b-ce356c778b29","name":"Add Chunks to Supabase","type":"@n8n/n8n-nodes-langchain.vectorStoreSupabase","typeVersion":1.3,"position":[1200,240],"parameters":{"mode":"insert","tableName":{"__rl":true,"mode":"id","value":"documents"},"options":{"queryName":"match_documents"}},"credentials":{"supabaseApi":{"id":"KdLzNsI1fZqoPyCt","name":"Supabase account"}},"retryOnFail":true,"maxTries":3,"waitBetweenTries":5000},{"id":"e8cec10c-e6ea-4eae-adb9-2ad29f81ddbc","name":"OpenAI Embeddings","type":"@n8n/n8n-nodes-langchain.embeddingsOpenAi","typeVersion":1.2,"position":[1160,560],"parameters":{"model":"text-embedding-3-small"},"credentials":{"openAiApi":{"id":"GQdth43VUJxkSsw9","name":"OpenAI account"}}},{"id":"5c383a12-dad4-4fae-a591-e161ba9b977c","name":"Shop Info Text","type":"@n8n/n8n-nodes-langchain.documentDefaultDataLoader","typeVersion":1.1,"position":[1360,560],"parameters":{"dataType":"json","jsonMode":"expressionData","jsonData":"={{ $json.text.replace(/\\\\([$.()!#*_\\[\\]\\-+])/g, \"$1\") }}","textSplittingMode":"custom","options":{"metadata":{"metadataValues":[{"name":"file_id","value":"={{ $('Config').item.json.FILE_ID }}"},{"name":"file_name","value":"={{ $('Config').item.json.FILE_NAME }}"},{"name":"version","value":"={{ $('Config').item.json.VERSION }}"}]}}}},{"id":"8261796d-6eaf-47cb-be84-b56a4ef2137b","name":"Split by Section","type":"@n8n/n8n-nodes-langchain.textSplitterRecursiveCharacterTextSplitter","typeVersion":1,"position":[1400,720],"parameters":{"chunkSize":500,"chunkOverlap":80,"options":{"splitCode":"markdown"}}},{"id":"3ed343cf-b5a2-4b77-8db1-2f3943d23394","name":"Remove Old Chunks","type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[1440,240],"parameters":{"operation":"executeQuery","query":"with fresh as (select count(*)::int as n from documents where metadata->>'file_id' = $1 and metadata->>'version' = $2), deleted as (delete from documents where metadata->>'file_id' = $1 and coalesce(metadata->>'version', '') <> $2 and (select n from fresh) > 0 returning id) select (select n from fresh) as chunks_indexed, (select count(*)::int from deleted) as old_chunks_removed","options":{"queryReplacement":"={{ $('Config').item.json.FILE_ID }},{{ $('Config').item.json.VERSION }}"}},"credentials":{"postgres":{"id":"KuHYFOV4eYWj9L5O","name":"Postgres account"}},"executeOnce":true,"retryOnFail":true,"maxTries":3,"waitBetweenTries":5000},{"id":"da5a5d7b-efc2-4799-a3d5-8bff4b2811a0","name":"New Chunks Saved?","type":"n8n-nodes-base.if","typeVersion":2.3,"position":[1680,240],"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"leftValue":"={{ $json.chunks_indexed }}","rightValue":0,"operator":{"type":"number","operation":"gt"}}],"combinator":"and"}}},{"id":"8c16a5b0-d904-4c0e-8c8e-117bd6882d41","name":"Sync Summary","type":"n8n-nodes-base.set","typeVersion":3.4,"position":[1920,160],"parameters":{"mode":"manual","includeOtherFields":false,"assignments":{"assignments":[{"id":"doc","name":"doc","value":"={{ $('Config').item.json.FILE_NAME }}","type":"string"},{"id":"version","name":"version","value":"={{ $('Config').item.json.VERSION }}","type":"string"},{"id":"chunks","name":"chunks_indexed","value":"={{ $json.chunks_indexed }}","type":"number"},{"id":"removed","name":"old_chunks_removed","value":"={{ $json.old_chunks_removed }}","type":"number"}]}}},{"id":"d2a3de04-d2bc-425a-a91d-1ca638fce3e7","name":"Fail: Nothing Indexed","type":"n8n-nodes-base.stopAndError","typeVersion":1,"position":[1920,360],"parameters":{"errorType":"errorMessage","errorMessage":"No new chunks were saved to Supabase, so the old chunks were kept. Check the OpenAI and Supabase credentials and the execution log."}},{"id":"eaf834aa-a814-414c-b8f3-745a3a3ee82a","name":"Refuse Near-Empty Doc","type":"n8n-nodes-base.stopAndError","typeVersion":1,"position":[1200,520],"parameters":{"errorType":"errorMessage","errorMessage":"The shop info doc has fewer than 500 characters, so it was not re-indexed and the bot keeps its current knowledge. Check the Google Doc for an accidental deletion (File > Version history)."}},{"id":"1bc710db-4593-4878-9dc4-335c3ee977d0","name":"Sticky Note 892c60a2","type":"n8n-nodes-base.stickyNote","typeVersion":1,"position":[190,190],"parameters":{"content":"## Knowledge Sync\nKeeps the chat bot's knowledge in step with the **Copperline Auto Repair: Shop Info** Google Doc.\n\n1. Runs when the doc changes (checked every 5 minutes) or when you click **Rebuild Now**.\n2. Exports the doc as Markdown.\n3. Refuses to index a doc under 500 characters, so an accidental delete can't wipe the bot's knowledge.","color":4,"width":1020,"height":400}},{"id":"fd964f46-1b57-4e9d-8674-9a82ab9d9c95","name":"Sticky Note 9d4f8268","type":"n8n-nodes-base.stickyNote","typeVersion":1,"position":[1150,110],"parameters":{"content":"## Insert first, delete second\nNew chunks are embedded (OpenAI `text-embedding-3-small`) and saved to Supabase with this run's `version`. Only then are the doc's older chunks deleted, and only if the new ones exist. The bot never sees an empty index, even if a step fails half-way.","color":5,"width":1020,"height":400}}],"connections":{"Shop Info Doc Updated":{"main":[[{"node":"Config","type":"main","index":0}]]},"Config":{"main":[[{"node":"Export Doc as Markdown","type":"main","index":0}]]},"Rebuild Now":{"main":[[{"node":"Config","type":"main","index":0}]]},"Export Doc as Markdown":{"main":[[{"node":"Doc Has Content?","type":"main","index":0}]]},"Doc Has Content?":{"main":[[{"node":"Add Chunks to Supabase","type":"main","index":0}],[{"node":"Refuse Near-Empty Doc","type":"main","index":0}]]},"Add Chunks to Supabase":{"main":[[{"node":"Remove Old Chunks","type":"main","index":0}]]},"OpenAI Embeddings":{"ai_embedding":[[{"node":"Add Chunks to Supabase","type":"ai_embedding","index":0}]]},"Shop Info Text":{"ai_document":[[{"node":"Add Chunks to Supabase","type":"ai_document","index":0}]]},"Split by Section":{"ai_textSplitter":[[{"node":"Shop Info Text","type":"ai_textSplitter","index":0}]]},"Remove Old Chunks":{"main":[[{"node":"New Chunks Saved?","type":"main","index":0}]]},"New Chunks Saved?":{"main":[[{"node":"Sync Summary","type":"main","index":0}],[{"node":"Fail: Nothing Indexed","type":"main","index":0}]]}},"settings":{"executionOrder":"v1","availableInMCP":true,"errorWorkflow":"IMDuCtka4p13GBto","timezone":"America/New_York"},"staticData":{"node:Shop Info Doc Updated":{"lastTimeChecked":"2026-10-01T15:02:24Z"}},"meta":{"aiBuilderAssisted":true,"builderVariant":"mcp"},"nodeGroups":[],"pinData":null,"versionId":"5c07010c-759c-44de-a4f4-94e56758345f","activeVersionId":"5c07010c-759c-44de-a4f4-94e56758345f","versionCounter":4,"triggerCount":1,"sourceWorkflowId":null,"tags":[{"updatedAt":"2026-10-01T12:00:05.096Z","createdAt":"2026-10-01T12:00:05.096Z","id":"Clu8sveTmN7O7jzV","name":"portfolio"},{"updatedAt":"2026-10-01T14:28:06.519Z","createdAt":"2026-10-01T14:28:06.519Z","id":"gmRhXTUQw3JARhrl","name":"support-bot"}],"shared":[{"updatedAt":"2026-10-01T14:27:57.528Z","createdAt":"2026-10-01T14:27:57.528Z","role":"workflow:owner","workflowId":"qflC4MXxlxqI8LfQ","projectId":"YsMTtqflyTWc3LOK","project":{"updatedAt":"2026-07-14T23:35:46.885Z","createdAt":"20