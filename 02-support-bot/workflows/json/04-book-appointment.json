[{"updatedAt":"2026-10-01T14:56:41.245Z","createdAt":"2026-10-01T14:41:29.163Z","id":"2oE6WCVdI69jWl8P","name":"Support Bot 4: Book Appointment","description":"Agent tool: validates booking details, enforces a per-chat limit, re-checks the slot with Support Bot 3, then creates the calendar event, logs it in Bookings and sends a fixed-template confirmation (test mode redirects it). Dry run only validates.","active":true,"isArchived":false,"nodes":[{"id":"a916293e-47c6-4d2c-87c7-8feb279a7dc3","name":"When Called by Agent","type":"n8n-nodes-base.executeWorkflowTrigger","typeVersion":1.2,"position":[240,300],"parameters":{"inputSource":"workflowInputs","workflowInputs":{"values":[{"name":"service","type":"string"},{"name":"start","type":"string"},{"name":"customer_name","type":"string"},{"name":"phone","type":"string"},{"name":"email","type":"string"},{"name":"vehicle","type":"string"},{"name":"notes","type":"string"},{"name":"session_id","type":"string"},{"name":"dry_run","type":"boolean"}]}}},{"id":"7d6acfbd-d208-4fa7-8dbc-59727ee2e670","name":"Config","type":"n8n-nodes-base.set","typeVersion":3.4,"position":[460,300],"parameters":{"mode":"manual","includeOtherFields":true,"assignments":{"assignments":[{"id":"test-mode","name":"TEST_MODE","value":true,"type":"boolean"},{"id":"test-inbox","name":"TEST_INBOX","value":"oladelesamuel56@gmail.com","type":"string"},{"id":"calendar-id","name":"CALENDAR_ID","value":"e535dd2bcfe011be160cf20a61416d5b25d758750392d5f3973e473dafe47b34@group.calendar.google.com","type":"string"},{"id":"timezone","name":"TIMEZONE","value":"America/New_York","type":"string"},{"id":"shop-phone","name":"SHOP_PHONE","value":"(617) 555-0142","type":"string"},{"id":"max-bookings","name":"MAX_BOOKINGS_PER_SESSION","value":2,"type":"number"}]}}},{"id":"62e6b28e-61e6-4abc-a576-eeb4dcb0b26b","name":"Read Session Bookings","type":"n8n-nodes-base.googleSheets","typeVersion":4.7,"position":[680,300],"parameters":{"resource":"sheet","operation":"read","documentId":{"__rl":true,"mode":"id","value":"1_RHqBp7k3rWBY-4plb2oo2mIryQlHIUuNOZ-YhCpVS8"},"sheetName":{"__rl":true,"mode":"id","value":"1","cachedResultName":"Bookings"},"filtersUI":{"values":[{"lookupColumn":"session_id","lookupValue":"={{ $json.session_id }}"}]},"options":{"returnAllMatches":"returnAllMatches"}},"credentials":{"googleSheetsOAuth2Api":{"id":"D8rKxzgMrJwmFZoQ","name":"Google Sheets account"}},"executeOnce":true,"retryOnFail":true,"maxTries":3,"waitBetweenTries":2000,"alwaysOutputData":true},{"id":"64f455d4-0dc3-4440-a32c-69d77eec268c","name":"Re-check Time","type":"n8n-nodes-base.executeWorkflow","typeVersion":1.3,"position":[900,300],"parameters":{"mode":"once","source":"database","workflowId":{"__rl":true,"mode":"id","value":"b4jIqNyj0KBxac3L","cachedResultName":"Support Bot 3: Check Availability"},"workflowInputs":{"mappingMode":"defineBelow","value":{"service":"={{ $('Config').first().json.service }}","date_from":"","date_to":"","check_start":"={{ $('Config').first().json.start }}"},"schema":[{"id":"service","displayName":"service","required":false,"defaultMatch":false,"display":true,"canBeUsedToMatch":true,"type":"string"},{"id":"date_from","displayName":"date_from","required":false,"defaultMatch":false,"display":true,"canBeUsedToMatch":true,"type":"string"},{"id":"date_to","displayName":"date_to","required":false,"defaultMatch":false,"display":true,"canBeUsedToMatch":true,"type":"string"},{"id":"check_start","displayName":"check_start","required":false,"defaultMatch":false,"display":true,"canBeUsedToMatch":true,"type":"string"}]},"options":{"waitForSubWorkflow":true}},"executeOnce":true},{"id":"758400b0-9038-4d70-ab7e-01960b85c11b","name":"Check Booking","type":"n8n-nodes-base.code","typeVersion":2,"position":[1120,300],"parameters":{"mode":"runOnceForAllItems","language":"javaScript","jsCode":"// Book only if the details are valid, the chat is under its booking limit, and the time is still free.\nconst cfg = $(\"Config\").first().json;\nconst check = $(\"Re-check Time\").first().json;\nconst previous = $(\"Read Session Bookings\").all().map(i => i.json).filter(r => r.booking_ref && r.session_id === cfg.session_id).length;\n// Strip links and cap lengths: these fields end up in an email to the address the customer typed.\nconst clean = (v, max) => String(v ?? \"\").replace(/https?:\\/\\/\\S+|www\\.\\S+/gi, \"\").replace(/\\s+/g, \" \").trim().slice(0, max);\nconst name = clean(cfg.customer_name, 60);\nconst email = clean(cfg.email, 100).toLowerCase();\nconst phone = clean(cfg.phone, 30);\nconst vehicle = clean(cfg.vehicle, 60);\nconst notes = clean(cfg.notes, 500);\nconst start = DateTime.fromISO(String(cfg.start ?? \"\"), { zone: cfg.TIMEZONE });\n\nconst missing = [];\nif (name.length < 2) missing.push(\"the customer's name\");\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) missing.push(\"a valid email address\");\nif (phone.replace(/\\D/g, \"\").length < 10) missing.push(\"a phone number with at least 10 digits\");\nif (vehicle.length < 3) missing.push(\"the vehicle's year, make and model\");\nif (!start.isValid) missing.push(\"a start time copied exactly from check_availability\");\n\nlet message = \"\";\nif (missing.length) {\n  message = \"Not booked. Still needed: \" + missing.join(\", \") + \".\";\n} else if (previous >= cfg.MAX_BOOKINGS_PER_SESSION) {\n  message = \"Not booked: this chat already has \" + previous + \" bookings, the most allowed. Ask the customer to call \" + cfg.SHOP_PHONE + \" for more.\";\n} else if (check.available !== true) {\n  message = \"Not booked: that time is no longer free. Call check_availability again and offer other times.\";\n}\n\nconst label = start.isValid ? start.toFormat(\"ccc LLL d, h:mm a\").replace(\" AM\", \" am\").replace(\" PM\", \" pm\") : \"\";\nconst testMode = cfg.TEST_MODE === true || cfg.TEST_MODE === \"true\";\nreturn [{\n  json: {\n    ok: !message,\n    message,\n    dry_run: cfg.dry_run === true || cfg.dry_run === \"true\",\n    booking_ref: \"CA-\" + Math.random().toString(36).slice(2, 7).toUpperCase(),\n    service: check.service ?? \"other\",\n    service_label: check.service_label ?? \"Other repair (drop-off)\",\n    start: start.isValid ? start.toISO() : \"\",\n    end: start.isValid ? start.plus({ minutes: check.duration_minutes ?? 60 }).toISO() : \"\",\n    label,\n    customer_name: name,\n    first_name: name.split(\" \")[0],\n    email,\n    phone,\n    vehicle,\n    notes,\n    session_id: cfg.session_id,\n    send_to: testMode ? cfg.TEST_INBOX : email,\n    subject: (testMode ? \"[TEST to \" + email + \"] \" : \"\") + \"Your Copperline booking: \" + label,\n    created_at: DateTime.now().setZone(cfg.TIMEZONE).toISO()\n  }\n}];\n"}},{"id":"27924340-00a2-456a-a778-a1d37f7b3e59","name":"OK to Book?","type":"n8n-nodes-base.if","typeVersion":2.3,"position":[1340,300],"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"leftValue":"={{ $json.ok }}","rightValue":true,"operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"}}},{"id":"17fe64f5-675f-425e-9c63-2212244ad496","name":"Dry Run?","type":"n8n-nodes-base.if","typeVersion":2.3,"position":[1560,200],"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"leftValue":"={{ $json.dry_run }}","rightValue":true,"operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"}}},{"id":"db51320f-97e7-4dfe-ab99-93ead1889967","name":"Dry Run Result","type":"n8n-nodes-base.set","typeVersion":3.4,"position":[1780,60],"parameters":{"mode":"manual","includeOtherFields":false,"assignments":{"assignments":[{"id":"success","name":"success","value":true,"type":"boolean"},{"id":"ref","name":"booking_ref","value":"=DRYRUN-{{ $json.booking_ref }}","type":"string"},{"id":"when","name":"when","value":"={{ $json.label }}","type":"string"},{"id":"message","name":"message","value":"Test run: the details are valid and the time is free. Nothing was booked.","type":"string"}]}}},{"id":"6d3f7649-4ff1-4682-b7c8-6bd875b5ef1c","name":"Create Calendar Event","type":"n8n-nodes-base.googleCalendar","typeVersion":1.3,"position":[1780,260],"parameters":{"resource":"event","operation":"create","calendar":{"__rl":true,"mode":"id","value":"={{ $('Config').item.json.CALENDAR_ID }}"},"start":"={{ $json.start }}","end":"={{ $json.end }}","additionalFields":{"summary":"={{ $json.service_label }}: {{ $json.customer_name }} ({{ $json.vehicle }})","description":"=Booking ref: {{ $json.booking_ref }}\nCustomer: {{ $json.customer_name }}\nPhone: {{ $json.phone }}\nEmail: {{ $json.email }}\nVehicle: {{ $json.vehicle }}\nNotes: {{ $json.notes || \"none\" }}\n\nBooked by the website chat assistant (session {{ $json.session_id }}).","location":"84 Foundry Lane, Allston, MA 02134","sendUpdates":"none"}},"credentials":{"googleCalendarOAuth2Api":{"id":"5G8pvfh0Kjd75Asw","name":"Google Calendar account"}},"retryOnFail":true,"maxTries":3,"waitBetweenTries":2000},{"id":"5bb3fa76-b5a1-41b2-8096-0e6ad4c31f2d","name":"Log Booking","type":"n8n-nodes-base.googleSheets","typeVersion":4.7,"position":[2000,260],"parameters":{"resource":"sheet","operation":"append","documentId":{"__rl":true,"mode":"id","value":"1_RHqBp7k3rWBY-4plb2oo2mIryQlHIUuNOZ-YhCpVS8"},"sheetName":{"__rl":true,"mode":"id","value":"1","cachedResultName":"Bookings"},"columns":{"mappingMode":"defineBelow","value":{"booking_ref":"={{ $('Check Booking').item.json.booking_ref }}","created_at":"={{ $('Check Booking').item.json.created_at }}","appointment_start":"={{ $('Check Booking').item.json.start }}","appointment_end":"={{ $('Check Booking').item.json.end }}","service":"={{ $('Check Booking').item.json.service }}","customer_name":"={{ $('Check Booking').item.json.customer_name }}","phone":"={{ $('Check Booking').item.json.phone }}","email":"={{ $('Check Booking').item.json.email }}","vehicle":"={{ $('Check Booking').item.json.vehicle }}","notes":"={{ $('Check Booking').item.json.notes }}","calendar_event_id":"={{ $json.id }}","session_id":"={{ $('Check Booking').item.json.session_id }}","status":"booked"},"schema":[{"id":"booking_ref","displayName":"booking_ref","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true},{"id":"created_at","displayName":"created_at","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true},{"id":"appointment_start","displayName":"appointment_start","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true},{"id":"appointment_end","displayName":"appointment_end","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true},{"id":"service","displayName":"service","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true},{"id":"customer_name","displayName":"customer_name","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true},{"id":"phone","displayName":"phone","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true},{"id":"email","displayName":"email","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true},{"id":"vehicle","displayName":"vehicle","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true},{"id":"notes","displayName":"notes","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true},{"id":"calendar_event_id","displayName":"calendar_event_id","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true},{"id":"session_id","displayName":"session_id","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true},{"id":"status","displayName":"status","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true}]},"options":{"cellFormat":"RAW","useAppend":true}},"credentials":{"googleSheetsOAuth2Api":{"id":"D8rKxzgMrJwmFZoQ","name":"Google Sheets account"}},"retryOnFail":true,"maxTries":3,"waitBetweenTries":5000},{"id":"4d5318b3-7d13-4cad-9391-20b8e55476ad","name":"Send Confirmation","type":"n8n-nodes-base.gmail","typeVersion":2.2,"position":[2220,260],"parameters":{"resource":"message","operation":"send","sendTo":"={{ $('Check Booking').item.json.send_to }}","subject":"={{ $('Check Booking').item.json.subject }}","emailType":"text","message":"=Hi {{ $('Check Booking').item.json.first_name }},\n\nYou're booked in at Copperline Auto Repair.\n\nReference: {{ $('Check Booking').item.json.booking_ref }}\nService: {{ $('Check Booking').item.json.service_label }}\nDrop-off: {{ $('Check Booking').item.json.label }}\nVehicle: {{ $('Check Booking').item.json.vehicle }}\n\nWhere: 84 Foundry Lane, Allston, MA 02134 (free parking out front)\nPlease bring your keys{{ $('Check Booking').item.json.service === 'state_inspection' ? ' and your vehicle registration' : '' }}. Most jobs are done the same day, and we'll text you when your car is ready.\n\nNeed to change or cancel? Reply to this email or call {{ $('Config').item.json.SHOP_PHONE }} at least 4 hours before. There's no cancellation fee.\n\nSee you soon,\nCopperline Auto Repair\n\n--\nThis booking was made through a demo of an AI chat assistant. Copperline Auto Repair is a fictional shop.\n","options":{"appendAttribution":false,"senderName":"Copperline Auto Repair"}},"credentials":{"gmailOAuth2":{"id":"9FKWoKxErtgj9Qg7","name":"Gmail account"}},"retryOnFail":true,"maxTries":3,"waitBetweenTries":5000,"webhookId":"1dddeeb5-953b-48de-a546-aee800665d8d"},{"id":"ea8d3c04-0049-4161-a8a5-4b305851f263","name":"Booking Result","type":"n8n-nodes-base.set","typeVersion":3.4,"position":[2440,260],"parameters":{"mode":"manual","includeOtherFields":false,"assignments":{"assignments":[{"id":"success","name":"success","value":true,"type":"boolean"},{"id":"ref","name":"booking_ref","value":"={{ $('Check Booking').item.json.booking_ref }}","type":"string"},{"id":"when","name":"when","value":"={{ $('Check Booking').item.json.label }}","type":"string"},{"id":"service","name":"service","value":"={{ $('Check Booking').item.json.service_label }}","type":"string"},{"id":"message","name":"message","value":"Booked. Give the customer the booking reference and say a confirmation email is on its way.","type":"string"}]}}},{"id":"6fb2a3f8-4b14-4e8d-944f-7382fd7dd3ba","name":"Not Booked","type":"n8n-nodes-base.set","typeVersion":3.4,"position":[1560,440],"parameters":{"mode":"manual","includeOtherFields":false,"assignments":{"assignments":[{"id":"success","name":"success","value":false,"type":"boolean"},{"id":"message","name":"message","value":"={{ $json.message }}","type":"string"}]}}},{"id":"d0976a34-ae68-42f6-953e-78e92e9114fd","name":"Sticky Note ca603e8c","type":"n8n-nodes-base.stickyNote","typeVersion":1,"position":[190,10],"parameters":{"content":"## Book Appointment (agent tool)\nCalled by the chat agent as `book_appointment` once the customer has confirmed the details.\n\n- Checks the details (email, phone, name, vehicle, a real start time).\n- At most `MAX_BOOKINGS_PER_SESSION` bookings per chat.\n- **Re-checks the time with Support Bot 3** right before booking, so two customers cannot take the last bay.\n- Eval runs pass `dry_run = true`: everything is checked but nothing is booked or sent.","color":4,"width":1840,"height":580}},{"id":"37f7f0d4-a104-42ad-b50d-7f0fa0d49b4a","name":"Sticky Note 8f367b01","type":"n8n-nodes-base.stickyNote","typeVersion":1,"position":[1730,210],"parameters":{"content":"## Book, log, confirm\nCreates the calendar event (no Google invite to the customer), logs the row in **Bookings**, and sends a fixed-template confirmation. The email text is not written by the AI, so the chat cannot be used to send arbitrary emails.\n\n`TEST_MODE` in **Config** sends every confirmation to `TEST_INBOX` instead.","color":5,"width":960,"height":200}}],"connections":{"When Called by Agent":{"main":[[{"node":"Config","type":"main","index":0}]]},"Config":{"main":[[{"node":"Read Session Bookings","type":"main","index":0}]]},"Read Session Bookings":{"main":[[{"node":"Re-check Time","type":"main","index":0}]]},"Re-check Time":{"main":[[{"node":"Check Booking","type":"main","index":0}]]},"Check Booking":{"main":[[{"node":"OK to Book?","type":"main","index":0}]]},"OK to Book?":{"main":[[{"node":"Dry Run?","type":"main","index":0}],[{"node":"Not Booked","type":"main","index":0}]]},"Dry Run?":{"main":[[{"node":"Dry Run Result","type":"main","index":0}],[{"node":"Create Calendar Event","type":"main","index":0}]]},"Create Calendar Event":{"main":[[{"node":"Log Booking","type":"main","index":0}]]},"Log Booking":{"main":[[{"node":"Send Confirmation","type":"main","index":0}]]},"Send Confirmation":{"main":[[{"node":"Booking Result","type":"main","index":0}]]}},"settings":{"executionOrder":"v1","availableInMCP":true,"errorWorkflow":"IMDuCtka4p13GBto","timezone":"America/New_York"},"staticData":null,"meta":{"aiBuilderAssisted":true,"builderVariant":"mcp"},"nodeGroups":[],"pinData":null,"versionId":"24b0cfa8-45b6-4413-9f31-078ee58298c8","activeVersionId":"24b0cfa8-45b6-4413-9f31-078ee58298c8","versionCounter":4,"triggerCount":0,"sourceWorkflowId":null,"tags":[{"updatedAt":"2026-10-01T12:00:05.096Z","createdAt":"2026-10-01T12:00:05.096Z","id":"Clu8sveTmN7O7jzV","name":"portfolio"},{"updatedAt":"2026-10-01T14:28:06.519Z","createdAt":"2026-10-01T14:28:06.519Z","id":"gmRhXTUQw3JARhrl","name":"support-bot"}],"shared":[{"updatedAt":"2026-10-01T14:41:29.166Z","createdAt":"2026-10-01T14:41:29.166Z","role":"workflow:owner","workflowId":"2oE6WCVdI69jWl8P","projectId":"YsMTtqflyTWc3LOK","project":{"updatedAt":"2026-07-14T23:35:46.885Z","createdAt":"2026-07-14T23:33:27.645Z","id":"YsMTtqflyTWc3LOK","name":"Samuel Oladele <samuel@carrotcredit.com>","type":"personal"