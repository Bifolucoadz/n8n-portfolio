      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Busy periods from Google Calendar (all-day events block the whole day; \"free\" events are ignored).\nconst busy = $input.all().map(i => i.json).filter(e => e && e.start && e.transparency !== 'transparent' && e.status !== 'cancelled').map(e => ({\n  start: e.start.dateTime || (e.start.date + 'T00:00:00'),\n  end: e.end.dateTime || (e.end.date + 'T00:00:00'),\n  title: e.summary || 'Busy'\n}));\nreturn [{ json: { busy } }];\n"
      }
