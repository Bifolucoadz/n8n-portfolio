        160
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Busy periods from the test calendar table that overlap the window asked for.\nconst r = $('Route').first().json;\nconst from = Date.parse(r.from), to = Date.parse(r.to);\nconst busy = $input.all().map(i => i.json).filter(e => e.start && e.end && Date.parse(e.end) > from && Date.parse(e.start) < to)\n  .map(e => ({ start: e.start, end: e.end, title: e.title }));\nreturn [{ json: { busy } }];\n"
      }
