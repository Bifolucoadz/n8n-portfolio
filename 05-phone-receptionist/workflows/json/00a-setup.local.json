    {
      "id": "dd75208b-217e-41a8-8b0e-ae2cd3d45cb9",
      "name": "Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2620,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const s = Object.fromEntries($(\"Read Settings Again\").all().map(i => [i.json.key, i.json.value ?? \"\"]));\nreturn [{\n  json: {\n    calendar_id: s.calendar_id || \"(missing)\",\n    sheet: s.sheet_id ? \"https://docs.google.com/spreadsheets/d/\" + s.sheet_id + \"/edit\" : \"(missing)\",\n    webhook_secret: s.webhook_secret ? \"set (\" + s.webhook_secret.length + \" characters)\" : \"(missing)\",\n    staff_chat_id: s.staff_chat_id || \"(empty: staff alerts are skipped until it is set)\",\n    next: \"Set public_base_url to the ngrok https address, create the 'Vapi API' credential, then run Receptionist 0b.\",\n  },\n}];\n"
      }
    },
    {
      "id": "a30af296-8a88-4f38-8662-09b36426b552",
      "name": "Sticky Note a30af296",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        160,
        40
      ],
      "parameters": {
        "content": "## Receptionist 0a: Setup (run once)\nCreates the **Fernhollow Dental (demo)** Google Calendar, the **Fernhollow Dental Front Desk** sheet (Calls and Messages tabs), and a random 40-character webhook secret, and saves them in the **Receptionist Settings** data table. Staff alerts default to Social Autopilot's Telegram approver chat.\n\nRefuses to run again once a calendar or sheet is saved. Next: put the ngrok address in `public_base_url` and run **0b** to create the Vapi assistant.",
        "color": 4,
        "width": 1000,
        "height": 200
      }
    }
