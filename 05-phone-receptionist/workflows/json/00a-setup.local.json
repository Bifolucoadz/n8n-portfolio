    {
      "id": "a6744276-40f2-480f-b1c3-325953e64fde",
      "name": "Plan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        860,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// One-off: refuses to run twice so it can't create a second calendar or sheet.\nconst s = Object.fromEntries($(\"Read Settings\").all().map(i => [i.json.key, i.json.value ?? \"\"]));\nif (s.calendar_id || s.sheet_id) throw new Error(\"Setup already ran (calendar_id / sheet_id are set in Receptionist Settings). Clear them first to start over.\");\nconst autopilot = Object.fromEntries($(\"Read Autopilot State\").all().map(i => [i.json.key, i.json.value ?? \"\"]));\n// Staff alerts go to the same Telegram chat as Social Autopilot's approver unless set already.\nreturn [{ json: { staff_chat_id: s.staff_chat_id || autopilot.approver_chat_id || \"\" } }];\n"
      }
    },
