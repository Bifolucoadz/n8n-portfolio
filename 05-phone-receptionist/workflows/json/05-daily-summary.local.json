    {
      "id": "e8738018-7232-4823-9959-19589a20905c",
      "name": "Next Day Window",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// The next day the clinic is open (tomorrow, or Monday after a Friday), for the schedule preview.\nconst tz = \"America/Chicago\";\nconst open = { 1: true, 2: true, 3: true, 4: true, 5: true };\nconst holidays = [\"2026-11-26\", \"2026-11-27\", \"2026-12-24\", \"2026-12-25\", \"2026-12-31\", \"2027-01-01\"];\nconst settings = Object.fromEntries($(\"Read Settings\").all().map(i => [i.json.key, i.json.value ?? \"\"]));\nlet d = DateTime.now().setZone(tz).startOf(\"day\").plus({ days: 1 });\nwhile (!open[d.weekday] || holidays.includes(d.toISODate())) d = d.plus({ days: 1 });\nreturn [{ json: { ...settings, next_day: d.toISODate(), time_min: d.toISO(), time_max: d.endOf(\"day\").toISO() } }];\n"
      }
    },
