    {
      "id": "dfd0cac3-83f4-44de-b480-6274210c66ca",
      "name": "Starting CRM",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1740,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// The demo CRM as it starts: three open deals at different stages, their companies and contacts,\n// and a little earlier activity. Every company, person and email is invented (.example domains).\n// ---- lib-tdw.js (included by build.py): shared helpers for the Tidewater workflows ----\nconst TZ = 'America/New_York';\nconst esc = s => String(s === null || s === undefined ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\nconst settingsOf = items => Object.fromEntries(items.map(i => i.json).filter(r => r && r.key).map(r => [r.key, r.value]));\nconst parseJson = (s, d) => { try { return typeof s === 'string' ? JSON.parse(s) : (s === null || s === undefined ? d : s); } catch (e) { return d; } };\nconst nowIso = () => DateTime.now().setZone(TZ).toISO();\nconst newId = (prefix, n) => prefix + Array.from({ length: n || 5 }, () => 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789'[Math.floor(Math.random() * 32)]).join('');\nconst newToken = n => Array.from({ length: n || 24 }, () => 'abcdefghijkmnpqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ23456789'[Math.floor(Math.random() * 56)]).join('');\nconst dollars = n => '$' + Math.round(Number(n) || 0).toLocaleString('en-US');\nconst mmss = s => Math.floor(s / 60) + ':' + String(Math.floor(s % 60)).padStart(2, '0');\n\n// HubSpot's default sales pipeline.\nconst STAGES = [\n  ['appointmentscheduled', 'Appointment scheduled', 'A first meeting is booked.'],\n  ['qualifiedtobuy', 'Qualified to buy', 'Need, rough budget, decision process and timeline are understood.'],\n  ['presentationscheduled', 'Presentation scheduled', 'A demo or presentation is booked or has been given.'],\n  ['decisionmakerboughtin', 'Decision maker bought-in', 'The person who signs has seen it and supports it.'],\n  ['contractsent', 'Contract sent', 'A proposal or contract has been sent.'],\n  ['closedwon', 'Closed won', 'Signed.'],\n  ['closedlost', 'Closed lost', 'The prospect said no.']\n];\nconst stageIndex = id => STAGES.findIndex(s => s[0] === id);\nconst stageLabel = id => (STAGES.find(s => s[0] === id) || [id, id])[1];\n\n// OpenAI node (Responses API) output: the JSON object from the first output_text part, or null.\nfunction aiJson(res) {\n  if (!res || res.error) return null;\n  const msg = (res.output || []).find(o => o && o.type === 'message');\n  const part = msg && (msg.content || []).find(c => c && c.type === 'output_text');\n  let t = part ? part.text : null;\n  if (typeof t === 'string') { try { t = JSON.parse(t); } catch (e) { t = null; } }\n  return t && typeof t === 'object' ? t : null;\n}\n\n// Is this quote really in the transcript? (case, punctuation and spacing ignored)\nconst norm = s => String(s || '').toLowerCase().replace(/[’']/g, \"'\").replace(/[^a-z0-9' ]+/g, ' ').replace(/\\s+/g, ' ').trim();\nconst quoteFound = (quote, transcriptNorm) => { const q = norm(quote); return q.length >= 6 && transcriptNorm.includes(q); };\n\nfunction emailHtml(company, paragraphs, extraHtml) {\n  const p = paragraphs.map(t => '<p style=\"margin:0 0 14px;text-align:left\">' + t + '</p>').join('');\n  return '<div style=\"font-family:Helvetica,Arial,sans-serif;font-size:15px;line-height:1.55;color:#1f2933;max-width:560px;text-align:left\">'\n    + '<div style=\"font-weight:700;font-size:13px;letter-spacing:1px;text-transform:uppercase;color:#1d4ed8;margin:0 0 18px\">' + esc(company) + '</div>'\n    + p + (extraHtml || '') + '</div>';\n}\nconst plainToHtml = t => String(t || '').split(/\\n{2,}/).map(p => '<p style=\"margin:0 0 14px;text-align:left\">' + esc(p).replace(/\\n/g, '<br>') + '</p>').join('');\n// ---- end lib-tdw.js ----\nconst now = DateTime.now().setZone(TZ);\nconst ago = d => now.minus({ days: d }).toISO();\nconst companies = [\n  { company_id: 'C-201', name: 'Calloway Dental Group', domain: 'callowaydental.example', industry: 'Dental clinics (5 locations)', size: '120 staff' },\n  { company_id: 'C-202', name: 'Pemberton Freight', domain: 'pembertonfreight.example', industry: 'Freight and logistics', size: '300 staff' },\n  { company_id: 'C-203', name: 'Ostara Home Care', domain: 'ostarahomecare.example', industry: 'Home care (8 branches)', size: '450 staff' }\n];\nconst contacts = [\n  { contact_id: 'P-301', company_id: 'C-201', name: 'Renee Alvarez', email: 'renee.alvarez@callowaydental.example', title: 'Operations Director' },\n  { contact_id: 'P-302', company_id: 'C-201', name: 'Mark Feld', email: 'mark.feld@callowaydental.example', title: 'COO' },\n  { contact_id: 'P-303', company_id: 'C-202', name: 'Tom Reyes', email: 'tom.reyes@pembertonfreight.example', title: 'IT Manager' },\n  { contact_id: 'P-304', company_id: 'C-202', name: 'Dana Whitcombe', email: 'dana.whitcombe@pembertonfreight.example', title: 'CFO' },\n  { contact_id: 'P-305', company_id: 'C-203', name: 'Janelle Brooks', email: 'janelle.brooks@ostarahomecare.example', title: 'CEO' }\n];\nconst deals = [\n  { deal_id: 'D-1001', name: 'Calloway Dental: patient reminders', company_id: 'C-201', stage: 'appointmentscheduled', amount: 0, close_date: '', owner: 'Maya Collins', next_step: 'Discovery call with Renee', updated_at: ago(6) },\n  { deal_id: 'D-1002', name: 'Pemberton Freight: customer tracking portal', company_id: 'C-202', stage: 'presentationscheduled', amount: 65000, close_date: now.plus({ days: 55 }).toISODate(), owner: 'Maya Collins', next_step: 'Demo follow-up call', updated_at: ago(7) },\n  { deal_id: 'D-1003', name: 'Ostara Home Care: caregiver scheduling app', company_id: 'C-203', stage: 'contractsent', amount: 28000, close_date: now.plus({ days: 24 }).toISODate(), owner: 'Maya Collins', next_step: 'Contract call with Janelle', updated_at: ago(3) }\n];\nconst activity = [\n  { activity_id: 'N-SEED1', deal_id: 'D-1001', kind: 'note', title: 'Inbound lead: website form', body: 'Asked about automating appointment reminders across 5 clinics.', owner: 'Maya Collins', due: '', status: 'done', source: 'seed', created_at: ago(9) },\n  { activity_id: 'N-SEED2', deal_id: 'D-1002', kind: 'meeting', title: 'Portal demo with the dispatch team', body: 'Showed live tracking and the customer portal. Tom Reyes and two dispatchers attended.', owner: 'Maya Collins', due: '', status: 'done', source: 'seed', created_at: ago(7) },\n  { activity_id: 'N-SEED3', deal_id: 'D-1003', kind: 'email', title: 'Contract v1 sent', body: 'Annual contract for 8 branches, $28,000.', owner: 'Maya Collins', due: '', status: 'done', source: 'seed', created_at: ago(3) }\n];\nreturn [\n  ...companies.map(r => ({ json: { table: 'companies', ...r } })),\n  ...contacts.map(r => ({ json: { table: 'contacts', ...r } })),\n  ...deals.map(r => ({ json: { table: 'deals', ...r } })),\n  ...activity.map(r => ({ json: { table: 'activity', ...r } }))\n];\n"
      },
      "executeOnce": true
    },
