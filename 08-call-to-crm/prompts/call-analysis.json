{
  "type": "object", "additionalProperties": false,
  "required": ["speakers", "summary", "key_points", "bant", "pains", "objections", "competitors", "next_steps", "stage_recommendation", "deal_updates", "risks", "sentiment", "follow_up_email"],
  "properties": {
    "speakers": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["label", "name", "side", "role"],
      "properties": { "label": { "type": "string" }, "name": { "type": "string" }, "side": { "type": "string", "enum": ["us", "them"] }, "role": { "type": "string" } } } },
    "summary": { "type": "string" },
    "key_points": { "type": "array", "items": { "type": "string" } },
    "bant": { "type": "object", "additionalProperties": false, "required": ["budget", "authority", "need", "timeline"],
      "properties": {
        "budget": { "$ref": "#/$defs/bant_item" }, "authority": { "$ref": "#/$defs/bant_item" },
        "need": { "$ref": "#/$defs/bant_item" }, "timeline": { "$ref": "#/$defs/bant_item" } } },
    "pains": { "type": "array", "items": { "type": "string" } },
    "objections": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["objection", "response", "status"],
      "properties": { "objection": { "type": "string" }, "response": { "type": "string" }, "status": { "type": "string", "enum": ["resolved", "open"] } } } },
    "competitors": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["name", "context"],
      "properties": { "name": { "type": "string" }, "context": { "type": "string" } } } },
    "next_steps": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["action", "owner", "side", "due", "quote"],
      "properties": { "action": { "type": "string" }, "owner": { "type": "string" }, "side": { "type": "string", "enum": ["us", "them"] }, "due": { "type": "string" }, "quote": { "type": "string" } } } },
    "stage_recommendation": { "type": "object", "additionalProperties": false, "required": ["stage", "confidence", "reason", "quote"],
      "properties": { "stage": { "type": "string", "enum": ["appointmentscheduled", "qualifiedtobuy", "presentationscheduled", "decisionmakerboughtin", "contractsent", "closedwon", "closedlost"] },
        "confidence": { "type": "string", "enum": ["high", "medium", "low"] }, "reason": { "type": "string" }, "quote": { "type": "string" } } },
    "deal_updates": { "type": "object", "additionalProperties": false, "required": ["amount", "amount_quote", "close_date", "close_date_quote"],
      "properties": { "amount": { "type": ["number", "null"] }, "amount_quote": { "type": "string" }, "close_date": { "type": "string" }, "close_date_quote": { "type": "string" } } },
    "risks": { "type": "array", "items": { "type": "string" } },
    "sentiment": { "type": "string", "enum": ["positive", "neutral", "negative"] },
    "follow_up_email": { "type": "object", "additionalProperties": false, "required": ["subject", "body"],
      "properties": { "subject": { "type": "string" }, "body": { "type": "string" } } }
  },
  "$defs": {
    "bant_item": { "type": "object", "additionalProperties": false, "required": ["status", "detail", "quote"],
      "properties": { "status": { "type": "string", "enum": ["known", "partial", "unknown"] }, "detail": { "type": "string" }, "quote": { "type": "string" } } }
  }
}
