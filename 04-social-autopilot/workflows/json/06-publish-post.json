t","operation":"create","authentication":"standard","postAs":"person","person":"={{ $json.linkedin_person }}","text":"={{ $json.linkedin_text }}","shareMediaCategory":"IMAGE","binaryPropertyName":"data","additionalFields":{"title":"={{ $json.topic }}","visibility":"={{ $json.visibility }}"}},"retryOnFail":true,"maxTries":2,"waitBetweenTries":5000,"onError":"continueErrorOutput"},{"id":"adfc9932-c0e8-49e8-afa0-c4570d6d8bdb","name":"LinkedIn Result","type":"n8n-nodes-base.code","typeVersion":2,"position":[2880,440],"parameters":{"mode":"runOnceForAllItems","language":"javaScript","jsCode":"// One result item for LinkedIn: ok with the post link, error, or skipped.\nconst p = $('Attach Image').first().json;\nif (!p.need_li) return [{ json: { platform: 'linkedin', status: 'skipped' } }];\nconst j = $json;\nif (j.urn) return [{ json: { platform: 'linkedin', status: 'ok', url: 'https://www.linkedin.com/feed/update/' + j.urn + '/' } }];\nlet error = String(j.error?.message || j.error || j.message || 'LinkedIn returned no post ID');\nif (!p.linkedin_person) error = 'LinkedIn is not connected yet (run Social Autopilot 8: Check Connections). ' + error;\nreturn [{ json: { platform: 'linkedin', status: 'error', error } }];\n"}},{"id":"00efe443-1eca-4330-84e8-2eb5446b581b","name":"LinkedIn With Link","type":"n8n-nodes-base.linkedIn","typeVersion":1,"position":[2660,460],"parameters":{"resource":"post","operation":"create","authentication":"standard","postAs":"person","person":"={{ $json.linkedin_person }}","text":"={{ $json.linkedin_text }}","shareMediaCategory":"ARTICLE","additionalFields":{"originalUrl":"={{ $json.link }}","title":"={{ $json.card ? $json.card.title : $json.topic }}","description":"={{ $json.card ? $json.card.description : '' }}","visibility":"={{ $json.visibility }}"}},"retryOnFail":true,"maxTries":2,"waitBetweenTries":5000,"onError":"continueErrorOutput"},{"id":"5862a46e-ac86-4b68-a364-60fba7bb9545","name":"LinkedIn Text Only","type":"n8n-nodes-base.linkedIn","typeVersion":1,"position":[2660,580],"parameters":{"resource":"post","operation":"create","authentication":"standard","postAs":"person","person":"={{ $json.linkedin_person }}","text":"={{ $json.linkedin_text }}","shareMediaCategory":"NONE","additionalFields":{"visibility":"={{ $json.visibility }}"}},"retryOnFail":true,"maxTries":2,"waitBetweenTries":5000,"onError":"continueErrorOutput"},{"id":"c76ac339-c53f-4d8d-a373-9453578b5875","name":"Channel Photo?","type":"n8n-nodes-base.if","typeVersion":2.2,"position":[2440,760],"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose"},"conditions":[{"leftValue":"={{ $json.tg_photo }}","operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"}}},{"id":"bd4d236b-676a-4299-8382-3a7cd8f0d157","name":"Send Channel Photo","type":"n8n-nodes-base.telegram","typeVersion":1.2,"position":[2660,680],"parameters":{"resource":"message","operation":"sendPhoto","chatId":"={{ $json.channel }}","binaryData":true,"binaryPropertyName":"data","additionalFields":{"caption":"={{ $json.telegram_html }}","parse_mode":"HTML","fileName":"={{ $json.post_id }}.jpg"}},"credentials":{"telegramApi":{"id":"V3kTN1drqw8YNjzk","name":"Telegram account"}},"retryOnFail":true,"maxTries":2,"waitBetweenTries":5000,"onError":"continueErrorOutput","webhookId":"09847a76-8f07-48c1-9cb5-1ca6fbe047c8"},{"id":"e3cbe9f4-c551-48e1-b032-56a783103f85","name":"Telegram Result","type":"n8n-nodes-base.code","typeVersion":2,"position":[2880,760],"parameters":{"mode":"runOnceForAllItems","language":"javaScript","jsCode":"// One result item for the Telegram channel: ok with the post link, error, or skipped.\nconst p = $('Attach Image').first().json;\nif (!p.need_tg) return [{ json: { platform: 'telegram', status: 'skipped' } }];\nconst j = $json;\nif (!p.channel) return [{ json: { platform: 'telegram', status: 'error', error: 'No telegram_channel in Settings.' } }];\nif (j.result && j.result.message_id) {\n  const user = j.result.chat && j.result.chat.username;\n  const url = user ? 'https://t.me/' + user + '/' + j.result.message_id : 'message ' + j.result.message_id + ' in ' + p.channel;\n  return [{ json: { platform: 'telegram', status: 'ok', url } }];\n}\nreturn [{ json: { platform: 'telegram', status: 'error', error: String(j.error?.message || j.error || j.description || 'Telegram returned no message') } }];\n"}},{"id":"d47270ef-89c7-4141-bf88-cbd9228edf73","name":"Send Channel Message","type":"n8n-nodes-base.telegram","typeVersion":1.2,"position":[2660,840],"parameters":{"resource":"message","operation":"sendMessage","chatId":"={{ $json.channel }}","text":"={{ $json.telegram_html }}","additionalFields":{"appendAttribution":false,"parse_mode":"HTML"}},"credentials":{"telegramApi":{"id":"V3kTN1drqw8YNjzk","name":"Telegram account"}},"retryOnFail":true,"maxTries":2,"waitBetweenTries":5000,"onError":"continueErrorOutput","webhookId":"2e062506-d9d5-4fab-a9f0-d5d1f9b316e5"},{"id":"9cff1f8e-47e9-4bd6-827d-6352f529274f","name":"All Results","type":"n8n-nodes-base.merge","typeVersion":3.2,"position":[3760,760],"parameters":{"mode":"append","numberInputs":2}},{"id":"c2b78feb-2b50-4509-a463-7a3cc275cc95","name":"Summarise","type":"n8n-nodes-base.code","typeVersion":2,"position":[3980,760],"parameters":{"mode":"runOnceForAllItems","language":"javaScript","jsCode":"// Combine the two results into the sheet update and the message for the owner.\nconst p = $('Attach Image').first().json;\nconst results = $input.all().map(i => i.json).filter(r => r.platform);\nconst label = { linkedin: 'LinkedIn', telegram: 'Telegram' };\nconst esc = s => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\nconst row = { post_id: p.post_id, updated_at: p.now_text };\nconst ok = results.filter(r => r.status === 'ok');\nconst failed = results.filter(r => r.status === 'error');\nfor (const r of ok) row[r.platform + '_url'] = r.url;\nconst done = ok.length + p.already.length;\nrow.status = failed.length === 0 ? 'posted' : done > 0 ? 'partial' : 'failed';\nif (ok.length) row.posted_at = p.now_text;\nconst problems = failed.map(f => label[f.platform] + ': ' + f.error);\nconst notes = [...p.notes, ...ok.filter(r => r.note).map(r => label[r.platform] + ': ' + r.note)];\nrow.error = [...problems, ...notes].join(' | ');\nrow.attempts = failed.length ? String(p.attempts + 1) : '0';\n\nconst lines = [];\nif (!failed.length) lines.push('✅ <b>Posted</b> · <code>' + p.post_id + '</code>');\nelse lines.push((ok.length ? '⚠️ <b>Partly posted</b>' : '❌ <b>Not posted</b>') + ' · <code>' + p.post_id + '</code>');\nlines.push('<i>' + esc(p.topic) + '</i>');\nfor (const r of ok) lines.push(label[r.platform] + ': ' + (/^https?:/.test(r.url) ? '<a href=\"' + esc(r.url) + '\">open post</a>' : esc(r.url)));\nfor (const r of failed) lines.push(label[r.platform] + ' failed: ' + esc(r.error.slice(0, 300)));\nfor (const n of notes) lines.push('⚠️ ' + esc(n));\nif (failed.length) lines.push('Fix the problem, then tap Retry. Platforms that already worked are not posted again.');\n\nreturn [{ json: { ...row, all_ok: failed.length === 0, owner_message: lines.join('\\n'), approver: p.approver } }];\n"}},{"id":"bac59052-6e44-43a7-9888-fef05daeee27","name":"Save Results","type":"n8n-nodes-base.googleSheets","typeVersion":4.7,"position":[4200,760],"parameters":{"resource":"sheet","operation":"update","documentId":{"__rl":true,"mode":"id","value":"1yAp5Z0eIMMvYO9DDx_Gtb_4CCNquU5vxNWaLH-WCzN8"},"sheetName":{"__rl":true,"mode":"id","value":"0","cachedResultName":"Calendar"},"columns":{"mappingMode":"autoMapInputData","value":{},"matchingColumns":["post_id"],"schema":[{"id":"post_id","displayName":"post_id","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true},{"id":"publish_at","displayName":"publish_at","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true},{"id":"topic","displayName":"topi