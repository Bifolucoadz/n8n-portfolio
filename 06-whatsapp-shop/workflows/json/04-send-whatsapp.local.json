    {
      "id": "17158766-10d0-4ce1-ac07-3074696870da",
      "name": "Read Settings",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        420,
        300
      ],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "PJ1UINshV66iby3v",
