    {
      "id": "c4b0f6f3-4a7e-49ec-9b27-650a914b8781",
      "name": "Check Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Paystack webhook: only charge.success matters, and only as a hint. The payment is confirmed\n// with Paystack's verify API next, so a forged webhook can't mark an order paid.\nconst b = $(\"Paystack Event\").first().json.body ?? {};\nif (b.event !== \"charge.success\" || !b.data?.reference) return [];\nreturn [{ json: { reference: String(b.data.reference) } }];\n"
      }
    },
    {
      "id": "1bcc50c4-f691-4f6a-8e15-3409aa21a775",
      "name": "Verify Payment",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        860,
        400
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://api.paystack.co/transaction/verify/{{ encodeURIComponent($json.reference) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000
        }
      },
      "credentials": {},
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "onError": "continueRegularOutput"
    },
    {
      "id": "4078ebb4-7e96-4213-a92a-122f83766e3d",
      "name": "Find Order",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        1080,
        400
      ],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "K3QpMm9jFMF8Daui",
          "cachedResultName": "Honeycrumb Orders"
        },
        "limit": 1,
        "filters": {
          "conditions": [
            {
              "keyName": "paystack_ref",
              "condition": "eq",
              "keyValue": "={{ $('Check Event').first().json.reference }}"
            }
          ]
        }
      },
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "id": "f8fbb11a-bcc1-4d10-aaf0-40be4ba8ceea",
      "name": "Decide",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// ---- lib-shop.js (included by build.py): prices, carts, zones and delivery rules ----\nconst SHOP = {\n  TZ: \"Africa/Lagos\",\n  OPEN_DAYS: [1, 2, 3, 4, 5, 6], // Monday-Saturday\n  CLOSED: [\"2026-12-25\", \"2026-12-26\", \"2027-01-01\"],\n  // window label -> start hour\n  WINDOWS: {\n    delivery: { \"10am-1pm\": 10, \"1pm-4pm\": 13, \"4pm-6pm\": 16 },\n    pickup: { \"9am-12pm\": 9, \"12pm-3pm\": 12, \"3pm-7pm\": 15 },\n  },\n  DAYS_AHEAD: 21,\n  MAX_QTY: 50,\n  CAKE_MESSAGE_MAX: 30,\n  PICKUP: \"14 Admiralty Way, Lekki Phase 1, Lagos\",\n};\n\nconst naira = n => \"₦\" + String(Math.round(Number(n) || 0)).replace(/\\B(?=(\\d{3})+(?!\\d))/g, \",\");\nconst clean = s => String(s ?? \"\").toLowerCase().replace(/[^a-z0-9 ]+/g, \" \").replace(/\\s+/g, \" \").trim();\nconst parseItems = json => {\n  try { const a = JSON.parse(json || \"[]\"); return Array.isArray(a) ? a : []; } catch (e) { return []; }\n};\nconst subtotalOf = items => items.reduce((s, i) => s + i.qty * i.unit_ngn, 0);\nconst itemLine = i => i.qty + \" × \" + i.name + (i.cake_message ? ' (message: \"' + i.cake_message + '\")' : \"\") + \" = \" + naira(i.qty * i.unit_ngn);\nconst newId = prefix => prefix + Array.from({ length: 4 }, () => \"ABCDEFGHJKLMNPQRSTUVWXYZ23456789\"[Math.floor(Math.random() * 32)]).join(\"\");\n\n// Product by SKU, else by name words (all words of the query must appear).\nfunction findProduct(products, ref) {\n  const r = String(ref ?? \"\").trim();\n  if (!r) return null;\n  const bySku = products.find(p => p.sku.toLowerCase() === r.toLowerCase());\n  if (bySku) return bySku;\n  const words = clean(r).split(\" \").filter(w => w.length > 1);\n  const hits = products.filter(p => words.every(w => clean(p.name + \" \" + p.sku).includes(w)));\n  return hits.length === 1 ? hits[0] : null;\n}\n\n// Delivery zone whose name or alias appears in the customer's text.\nfunction matchZone(zones, text) {\n  const t = \" \" + clean(text) + \" \";\n  let best = null;\n  for (const z of zones) {\n    const names = [z.area, ...String(z.aliases ?? \"\").split(\",\")].map(clean).filter(Boolean);\n    for (const n of names) {\n      if (t.includes(\" \" + n + \" \") && (!best || n.length > best.len)) best = { zone: z, len: n.length };\n    }\n  }\n  return best ? best.zone : null;\n}\n\nfunction isOpenDay(d) {\n  return SHOP.OPEN_DAYS.includes(d.weekday) && !SHOP.CLOSED.includes(d.toISODate());\n}\n\n// Earliest (day, window) that respects the longest lead time in the cart.\nfunction earliestSlot(leadHours, fulfilment, now) {\n  const windows = SHOP.WINDOWS[fulfilment] || SHOP.WINDOWS.delivery;\n  const ready = now.plus({ hours: leadHours });\n  for (let d = now.startOf(\"day\"); d <= now.startOf(\"day\").plus({ days: SHOP.DAYS_AHEAD }); d = d.plus({ days: 1 })) {\n    if (!isOpenDay(d)) continue;\n    for (const [label, hour] of Object.entries(windows)) {\n      if (d.set({ hour }) >= ready) return { date: d, window: label };\n    }\n  }\n  return null;\n}\n\n// \"Thursday 30 October, 1pm-4pm\"\nconst sayDay = d => d.toFormat(\"cccc d LLLL\");\n// ---- end lib-shop.js ----\n// Verified transaction + our order -> paid, duplicate, or mismatch.\nconst ref = $(\"Check Event\").first().json.reference;\nconst v = $(\"Verify Payment\").first().json;\nconst order = $input.all().map(i => i.json).find(o => o && o.order_id);\nconst tx = v?.data ?? {};\nconst now = DateTime.now().setZone(SHOP.TZ);\nconst esc = s => String(s ?? \"\").replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\nif (!order) return [{ json: { action: \"alert\", text: \"⚠️ Paystack payment \" + esc(ref) + \" (\" + naira((tx.amount || 0) / 100) + \") doesn't match any open order. Check the Paystack dashboard.\" } }];\nif (order.status !== \"awaiting_payment\") return [{ json: { action: \"ignore\", reason: \"order already \" + order.status } }];\nconst okTx = v?.status === true && tx.status === \"success\" && tx.currency === \"NGN\" && Number(tx.amount) === Math.round(Number(order.total_ngn) * 100);\nif (!okTx) return [{ json: { action: \"alert\", text: \"⚠️ Payment for \" + esc(order.order_id) + \" didn't verify: Paystack says \" + esc(tx.status) + \", \" + naira((tx.amount || 0) / 100) + \" vs order total \" + naira(order.total_ngn) + \". Not marked paid.\" } }];\nconst items = parseItems(order.items_json);\nconst when = sayDay(DateTime.fromISO(order.deliver_on, { zone: SHOP.TZ })) + \", \" + order.window;\nreturn [{\n  json: {\n    action: \"paid\",\n    order: { ...order, status: \"paid\", paid_at: now.toISO(), updated_at: now.toISO() },\n    customer_text: \"Payment received, thank you \" + (order.customer_name.split(\" \")[0] || \"\") + \"! 🎉\\n\\n\" +\n      \"*Order \" + order.order_id + \"* is confirmed:\\n\" + items.map(i => \"• \" + i.qty + \" × \" + i.name + (i.cake_message ? ' (\"' + i.cake_message + '\")' : \"\")).join(\"\\n\") +\n      \"\\n\\n\" + (order.fulfilment === \"delivery\" ? \"🚚 Delivery \" + when + \" to \" + order.address : \"🛍️ Pickup \" + when + \" at \" + SHOP.PICKUP) +\n      \"\\nTotal paid: \" + naira(order.total_ngn) + \"\\n\\nWe'll message you here when it's on its way.\",\n    owner_text: \"🧁 <b>New paid order \" + esc(order.order_id) + \"</b> · \" + naira(order.total_ngn) + \"\\n\" +\n      esc(order.customer_name) + \", +\" + esc(order.phone) + \"\\n\" + items.map(i => \"• \" + i.qty + \" × \" + esc(i.name) + (i.cake_message ? ' (\"' + esc(i.cake_message) + '\")' : \"\")).join(\"\\n\") +\n      \"\\n\" + (order.fulfilment === \"delivery\" ? \"🚚 \" + esc(when) + \", \" + esc(order.area) + \": \" + esc(order.address) : \"🛍️ Pickup \" + esc(when)) + (order.note ? \"\\n📝 \" + esc(order.note) : \"\"),\n    board_row: {\n      order_id: order.order_id, status: \"paid\", deliver_on: order.deliver_on, window: order.window,\n      fulfilment: order.fulfilment, area: order.area, address: order.address, customer: order.customer_name, phone: \"+\" + order.phone,\n      items: items.map(i => i.qty + \" × \" + i.name + (i.cake_message ? ' (\"' + i.cake_message + '\")' : \"\")).join(\"; \"),\n      total_ngn: String(order.total_ngn), note: order.note, paid_at: now.toFormat(\"yyyy-MM-dd HH:mm\"),\n    },\n  },\n}];\n"
      }
    },
