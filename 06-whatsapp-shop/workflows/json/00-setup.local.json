        "url": "https://sheets.googleapis.com/v4/spreadsheets?fields=spreadsheetId,spreadsheetUrl",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleSheetsOAuth2Api",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": {
          "properties": {
            "title": "Honeycrumb Kitchen Board",
            "timeZone": "Africa/Lagos"
          },
          "sheets": [
            {
              "properties": {
                "sheetId": 0,
                "title": "Orders",
                "gridProperties": {
                  "frozenRowCount": 1
                }
              },
              "data": [
                {
                  "startRow": 0,
                  "startColumn": 0,
                  "rowData": [
                    {
                      "values": [
                        {
                          "userEnteredValue": {
                            "stringValue": "order_id"
                          }
                        },
                        {
                          "userEnteredValue": {
                            "stringValue": "status"
                          }
                        },
                        {
