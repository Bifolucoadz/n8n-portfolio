    {
      "id": "4b0196a9-7825-4698-a14a-92e0039110bb",
      "name": "Plan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        860,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// One-off: refuses to run twice so it can't create a second kitchen board.\nconst s = Object.fromEntries($(\"Read Settings\").all().map(i => [i.json.key, i.json.value ?? \"\"]));\nif (s.kitchen_sheet_id) throw new Error(\"Setup already ran (kitchen_sheet_id is set in Honeycrumb Settings). Clear it first to start over.\");\nconst autopilot = Object.fromEntries($(\"Read Autopilot State\").all().map(i => [i.json.key, i.json.value ?? \"\"]));\nreturn [{ json: { owner_chat_id: s.owner_chat_id || autopilot.approver_chat_id || \"\" } }];\n"
      }
    },
    {
