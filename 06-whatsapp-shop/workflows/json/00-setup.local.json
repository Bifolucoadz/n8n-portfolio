    {
      "id": "a796e475-05c7-4db3-b943-6c4e9b23e98d",
      "name": "Settings Rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1520,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "return [\n  { json: { key: \"kitchen_sheet_id\", value: $(\"Create Kitchen Board\").first().json.spreadsheetId } },\n  { json: { key: \"owner_chat_id\", value: $(\"Plan\").first().json.owner_chat_id } },\n];\n"
