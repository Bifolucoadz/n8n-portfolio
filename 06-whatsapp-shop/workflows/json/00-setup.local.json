                          }
                        },
                        {
                          "userEnteredValue": {
                            "stringValue": "phone"
                          }
                        },
                        {
                          "userEnteredValue": {
                            "stringValue": "items"
                          }
                        },
                        {
                          "userEnteredValue": {
                            "stringValue": "total_ngn"
                          }
                        },
                        {
                          "userEnteredValue": {
                            "stringValue": "note"
                          }
                        },
                        {
                          "userEnteredValue": {
                            "stringValue": "paid_at"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "D8rKxzgMrJwmFZoQ",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "id": "30018b61-6de2-4d2c-b888-fb0af96681db",
      "name": "Format Board",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1300,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://sheets.googleapis.com/v4/spreadsheets/{{ $json.spreadsheetId }}:batchUpdate",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleSheetsOAuth2Api",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": {
          "requests": [
            {
              "repeatCell": {
                "range": {
                  "sheetId": 0,
                  "startRowIndex": 0,
                  "endRowIndex": 1
                },
                "cell": {
                  "userEnteredFormat": {
                    "textFormat": {
                      "bold": true,
                      "foregroundColor": {
                        "red": 1,
                        "green": 1,
                        "blue": 1
                      }
                    },
                    "backgroundColor": {
                      "red": 0.55,
                      "green": 0.33,
                      "blue": 0.16
                    }
                  }
                },
                "fields": "userEnteredFormat(textFormat,backgroundColor)"
              }
            },
            {
              "setDataValidation": {
                "range": {
                  "sheetId": 0,
                  "startRowIndex": 1,
                  "startColumnIndex": 1,
                  "endColumnIndex": 2
                },
                "rule": {
                  "condition": {
                    "type": "ONE_OF_LIST",
                    "values": [
                      {
                        "userEnteredValue": "paid"
                      },
                      {
                        "userEnteredValue": "baking"
                      },
                      {
                        "userEnteredValue": "out_for_delivery"
                      },
                      {
                        "userEnteredValue": "ready_for_pickup"
                      },
                      {
                        "userEnteredValue": "delivered"
                      },
                      {
                        "userEnteredValue": "cancelled"
                      }
                    ]
                  },
                  "showCustomUi": true,
                  "strict": true
                }
              }
            },
            {
              "addConditionalFormatRule": {
                "index": 0,
                "rule": {
                  "ranges": [
                    {
                      "sheetId": 0,
                      "startRowIndex": 1,
                      "startColumnIndex": 1,
                      "endColumnIndex": 2
                    }
                  ],
                  "booleanRule": {
                    "condition": {
                      "type": "TEXT_EQ",
                      "values": [
                        {
                          "userEnteredValue": "paid"
                        }
                      ]
                    },
                    "format": {
                      "backgroundColor": {
                        "red": 1,
                        "green": 0.95,
                        "blue": 0.8
                      }
                    }
                  }
                }
              }
            },
            {
              "addConditionalFormatRule": {
                "index": 1,
                "rule": {
                  "ranges": [
                    {
                      "sheetId": 0,
                      "startRowIndex": 1,
                      "startColumnIndex": 1,
                      "endColumnIndex": 2
                    }
                  ],
                  "booleanRule": {
                    "condition": {
                      "type": "TEXT_EQ",
                      "values": [
                        {
                          "userEnteredValue": "baking"
                        }
                      ]
                    },
                    "format": {
                      "backgroundColor": {
                        "red": 1,
                        "green": 0.88,
                        "blue": 0.75
                      }
                    }
                  }
                }
              }
            },
            {
              "addConditionalFormatRule": {
                "index": 2,
                "rule": {
                  "ranges": [
                    {
                      "sheetId": 0,
                      "startRowIndex": 1,
                      "startColumnIndex": 1,
                      "endColumnIndex": 2
                    }
                  ],
                  "booleanRule": {
                    "condition": {
                      "type": "TEXT_EQ",
                      "values": [
                        {
                          "userEnteredValue": "out_for_delivery"
                        }
                      ]
                    },
                    "format": {
                      "backgroundColor": {
                        "red": 0.82,
                        "green": 0.9,
                        "blue": 1
                      }
                    }
                  }
                }
              }
            },
            {
              "addConditionalFormatRule": {
                "index": 3,
                "rule": {
                  "ranges": [
                    {
                      "sheetId": 0,
                      "startRowIndex": 1,
                      "startColumnIndex": 1,
                      "endColumnIndex": 2
                    }
                  ],
                  "booleanRule": {
                    "condition": {
                      "type": "TEXT_EQ",
                      "values": [
                        {
                          "userEnteredValue": "delivered"
                        }
                      ]
                    },
                    "format": {
                      "backgroundColor": {
                        "red": 0.82,
                        "green": 0.94,
                        "blue": 0.84
                      }
                    }
                  }
                }
              }
            },
            {
              "updateDimensionProperties": {
                "range": {
                  "sheetId": 0,
                  "dimension": "COLUMNS",
                  "startIndex": 6,
                  "endIndex": 7
                },
                "properties": {
                  "pixelSize": 260
                },
                "fields": "pixelSize"
              }
            },
            {
              "updateDimensionProperties": {
                "range": {
                  "sheetId": 0,
                  "dimension": "COLUMNS",
                  "startIndex": 9,
                  "endIndex": 10
                },
                "properties": {
                  "pixelSize": 360
                },
                "fields": "pixelSize"
              }
            }
          ]
        }
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "D8rKxzgMrJwmFZoQ",
