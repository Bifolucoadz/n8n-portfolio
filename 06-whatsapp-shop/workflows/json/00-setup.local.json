    {
      "id": "17d6b2e5-8d4a-43a2-9601-f819fa98e73f",
      "name": "Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2180,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const s = Object.fromEntries($(\"Read Settings Again\").all().map(i => [i.json.key, i.json.value ?? \"\"]));\nreturn [{ json: {\n  kitchen_board: s.kitchen_sheet_id ? \"https://docs.google.com/spreadsheets/d/\" + s.kitchen_sheet_id + \"/edit\" : \"(missing)\",\n  owner_chat_id: s.owner_chat_id || \"(empty: owner alerts are skipped until it is set)\",\n  payments: s.payments,\n  next: \"Create the WhatsApp and Paystack credentials, set whatsapp_phone_number_id, then publish Honeycrumb 1 and 5.\",\n} }];\n"
      }
    },
    {
      "id": "ec605e79-047d-4858-97a3-a31845a424f2",
      "name": "Sticky Note ec605e79",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        160,
        40
      ],
      "parameters": {
        "content": "## Honeycrumb 0: Setup (run once)\nCreates the **Honeycrumb Kitchen Board** Google Sheet (status dropdown and colours for paid, baking, out for delivery, delivered) and saves its ID in **Honeycrumb Settings**. The owner's Telegram chat defaults to Social Autopilot's approver chat.\n\nThe menu, delivery zones and settings rows were loaded straight into the data tables when the project was built.",
        "color": 5,
        "width": 900,
        "height": 200
      }
    }
  ],
