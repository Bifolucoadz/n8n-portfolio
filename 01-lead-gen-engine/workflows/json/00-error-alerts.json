        "type": "n8n-nodes-base.errorTrigger",
        "typeVersion": 1,
        "position": [
          240,
          300
        ],
        "parameters": {}
      },
      {
        "id": "227aa224-2a94-41c4-92e4-6316535879bb",
        "name": "Config",
        "type": "n8n-nodes-base.set",
        "typeVersion": 3.4,
        "position": [
          460,
          300
        ],
        "parameters": {
          "mode": "manual",
          "includeOtherFields": true,
          "assignments": {
            "assignments": [
              {
                "id": "alert-email",
                "name": "ALERT_EMAIL",
                "value": "samuelgurru@gmail.com",
                "type": "string"
              }
            ]
          }
        }
      },
      {
        "id": "dec10eb0-10a7-41fe-b770-3e4592fdf5ab",
        "name": "Email Failure Alert",
        "type": "n8n-nodes-base.gmail",
        "typeVersion": 2.2,
        "position": [
          680,
          300
        ],
        "parameters": {
          "resource": "message",
          "operation": "send",
          "sendTo": "={{ $json.ALERT_EMAIL }}",
          "subject": "=n8n failure: {{ $json.workflow.name }}",
          "emailType": "text",
          "message": "=A Lead Engine workflow failed.\n\nWorkflow: {{ $json.workflow.name }}\nFailed node: {{ $json.execution.lastNodeExecuted ?? \"unknown\" }}\nError: {{ $json.execution.error?.message ?? \"no message\" }}\nTime: {{ $now.toFormat(\"yyyy-MM-dd HH:mm\") }}\n\nOpen the execution: {{ $json.execution.url ?? \"n/a\" }}\n",
          "options": {
            "appendAttribution": false
          }
        },
        "credentials": {
          "gmailOAuth2": {
            "id": "9FKWoKxErtgj9Qg7",
            "name": "Gmail account"
          }
        },
        "retryOnFail": true,
        "maxTries": 3,
        "waitBetweenTries": 5000,
        "webhookId": "840b2a82-9ec8-44f6-a401-bd8f337b8e18"
      },
      {
        "id": "33197e18-b1fa-45c8-9ed1-7f131bd1b371",
        "name": "Sticky Note 9b6aecd9",
        "type": "n8n-nodes-base.stickyNote",
        "typeVersion": 1,
        "position": [
          140,
          -60
        ],
        "parameters": {
          "content": "## Error alerts\nShared error handler for the three Lead Engine workflows. Each one names this workflow in its settings, so any failed production run sends an email with the workflow, the failing node, the error and a link to the execution.\n\nChange `ALERT_EMAIL` in **Config** to send alerts somewhere else.",
          "color": 3,
          "width": 700,
          "height": 560
        }
      }
    ],
