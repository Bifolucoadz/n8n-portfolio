      {
        "parameters": {
          "jsCode": "// Who gets an email this run: due follow-ups first, then the best new leads, within the daily cap.\nconst cfg = $(\"Config\").first().json;\nconst days = cfg.FOLLOWUP_DAYS;\nconst maxEmails = days.length + 1;\nconst now = DateTime.now();\nconst isEmail = e => /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(String(e ?? \"\").trim());\nconst rows = $input.all().map(i => i.json).filter(r => r.place_id);\n\nconst sentToday = rows.filter(r => r.last_email_at && DateTime.fromISO(String(r.last_email_at)).hasSame(now, \"day\")).length;\nconst budget = Math.max(0, Math.min(cfg.MAX_PER_RUN, cfg.DAILY_SEND_CAP - sentToday));\nif (budget === 0) return [];\n\nconst followUps = rows\n  .filter(r => r.status === \"contacted\" && r.last_message_id && Number(r.emails_sent) < maxEmails\n    && r.next_followup_at && DateTime.fromISO(String(r.next_followup_at)) <= now)\n  .sort((a, b) => String(a.next_followup_at).localeCompare(String(b.next_followup_at)));\n\n// Never start a second sequence with an address that is already in one.\nconst usedEmails = new Set(rows.filter(r => ![\"new\", \"no_email\"].includes(r.status)).map(r => String(r.email).toLowerCase().trim()));\nconst firstEmails = [];\nconst candidates = rows\n  .filter(r => r.status === \"new\" && isEmail(r.email) && Number(r.lead_score) >= cfg.MIN_SCORE)\n  .sort((a, b) => Number(b.lead_score) - Number(a.lead_score));\nfor (const r of candidates) {\n  const email = String(r.email).toLowerCase().trim();\n  if (usedEmails.has(email)) continue;\n  usedEmails.add(email);\n  firstEmails.push(r);\n}\n\nreturn [...followUps, ...firstEmails].slice(0, budget).map(r => {\n  const step = Number(r.emails_sent || 0) + 1;\n  // FOLLOWUP_DAYS counts days after the first email, so [3, 7] sends on day 0, day 3 and day 7.\n  const gap = step <= days.length ? days[step - 1] - (step > 1 ? days[step - 2] : 0) : null;\n  return {\n    json: {\n      ...r,\n      step,\n      send_to: cfg.TEST_MODE ? cfg.TEST_INBOX : String(r.email).trim(),\n      is_test: cfg.TEST_MODE === true,\n      status_after_send: gap === null ? \"finished\" : \"contacted\",\n      next_followup_at_after_send: gap === null ? \"\" : now.plus({ days: gap }).toISO(),\n    },\n  };\n});"
        },
        "id": "5496ec69-7b2e-48f7-a2be-777667ab44e7",
        "name": "Pick Leads Due Now",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          960,
          304
        ]
      },
      {
        "parameters": {
          "promptType": "define",
          "text": "=Write email {{ $json.step }} of {{ $(\"Config\").first().json.FOLLOWUP_DAYS.length + 1 }} in the sequence.\n\nBusiness: {{ $json.business_name }}\nCategory: {{ $json.category || \"unknown\" }}\nArea: {{ $json.city || \"unknown\" }}\nGoogle rating: {{ $json.rating || \"none\" }} from {{ $json.reviews || 0 }} reviews\nWebsite: {{ $json.website || \"none\" }}\nOpening line idea: {{ $json.personal_line || \"none\" }}\n\nWhat I offer: {{ $(\"Config\").first().json.OFFER }}\nMy first name: {{ $(\"Config\").first().json.SENDER_NAME }}",
          "hasOutputParser": true,
          "messages": {
            "messageValues": [
              {
                "type": "SystemMessagePromptTemplate",
                "message": "You write short, plain-text cold emails for a freelancer who builds AI automations for small businesses. Each email must read as if a real person wrote it to this one business.\n\nRules for every email: under 120 words; plain text with no markdown, links or emojis; no exclamation marks; no buzzwords such as leverage, revolutionise, game-changer or cutting-edge; never invent facts about the business; never point out a weakness such as a low rating or few reviews; no sign-off, signature or unsubscribe line, because those are added automatically.\n\nEmail 1 (intro): greet the team, open with the opening line idea in your own words (skip it if it mentions a weakness), connect it to one specific problem the offer solves for this kind of business, and ask for a 15-minute call. The subject has at most 6 words and must not look like marketing.\nEmail 2 (bump): 2 or 3 sentences following up on the first email. Add one new, concrete example of an automation this business could use, and ask whether a short call is worth it.\nEmail 3 (break-up): 2 or 3 polite sentences saying this is the last email, leaving the door open if the timing changes.\n\nEmails 2 and 3 are sent as replies in the same thread, so their subject is not used, but still return one."
              }
            ]
          },
          "batching": {}
        },
        "id": "91e68265-dbf2-4fe3-96e8-0c3f25425b11",
        "name": "Write Email with AI",
