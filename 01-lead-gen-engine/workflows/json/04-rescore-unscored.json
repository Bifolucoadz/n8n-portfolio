    "name": "Lead Engine 4: Rescore Unscored Leads",
    "description": "Manual utility: scores sheet rows whose lead_score is empty (e.g. after an AI failure in the Lead Scraper) and writes lead_score, score_reason and personal_line back.",
    "active": false,
    "isArchived": false,
    "nodes": [
      {
        "id": "e754b85d-5a65-4ae7-a5b2-b1010455e36e",
        "name": "Run Manually",
        "type": "n8n-nodes-base.manualTrigger",
