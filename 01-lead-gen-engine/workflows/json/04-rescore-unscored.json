      {
        "id": "276e9f0f-c585-4611-b613-ba31bb2259aa",
        "name": "Sticky Note 01d75c45",
        "type": "n8n-nodes-base.stickyNote",
        "typeVersion": 1,
        "position": [
          140,
          60
        ],
        "parameters": {
          "content": "## Rescore unscored leads\nThe Lead Scraper saves a place even when the AI scoring step fails, so no Apify results are lost. Those rows have an empty `lead_score` and are never emailed.\n\nRun this workflow by hand to score them afterwards. It only touches rows with an empty `lead_score` and only writes `lead_score`, `score_reason` and `personal_line`. Keep `OFFER` in **Config** the same as in the other workflows.",
          "color": 4,
          "width": 1520,
          "height": 640
        }
      }
