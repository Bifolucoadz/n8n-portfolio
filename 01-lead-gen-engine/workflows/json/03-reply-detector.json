      {
        "parameters": {
          "jsCode": "// Match each new inbox message to a lead by Gmail thread, then by sender address. Anything else is ignored.\nconst leads = $input.all().map(i => i.json).filter(r => r.place_id);\nconst byThread = new Map(leads.filter(l => l.thread_id).map(l => [String(l.thread_id), l]));\nconst byEmail = new Map(leads.filter(l => l.email).map(l => [String(l.email).toLowerCase().trim(), l]));\nconst out = [];\n\nfor (const { json: m } of $(\"Check Inbox Every 5 Min\").all()) {\n  const from = String(m.from?.value?.[0]?.address ?? \"\").toLowerCase();\n  const subject = String(m.subject ?? \"\");\n  const text = String(m.text ?? \"\");\n  const isBounce = /mailer-daemon|postmaster/.test(from)\n    || /delivery status notification|undeliverable|delivery has failed|returned mail/i.test(subject);\n\n  let lead = byThread.get(String(m.threadId)) ?? byEmail.get(from);\n  if (!lead && isBounce) lead = leads.find(l => l.email && text.toLowerCase().includes(String(l.email).toLowerCase()));\n  if (!lead) continue;\n\n  // Keep only the new reply, not the quoted thread under it. Braces are removed because the AI prompt treats them as variables.\n  const reply = text\n    .split(/\\r?\\nOn [\\s\\S]{0,200}?wrote:|\\r?\\n-+ ?Original Message ?-+|\\r?\\nFrom: /)[0]\n    .replace(/^>.*$/gm, \"\")\n    .replace(/[{}]/g, \"\")\n    .trim()\n    .slice(0, 3000);\n  const isStop = /^\\W*(stop|unsubscribe|remove me|take me off)\\b/i.test(reply);\n\n  out.push({\n    json: {\n      place_id: lead.place_id,\n      business_name: String(lead.business_name ?? \"\").replace(/[{}]/g, \"\"),\n      lead_status: lead.status,\n      previous_replied_at: lead.replied_at ?? \"\",\n      thread_id: m.threadId,\n      from,\n      subject: subject.replace(/[{}]/g, \"\"),\n      reply_text: reply,\n      route: isBounce ? \"bounce\" : isStop ? \"stop\" : \"classify\",\n    },\n  });\n}\n\nreturn out;"
        },
        "id": "182d71d4-3e88-4f31-ad40-553e366dd698",
