      {
        "parameters": {
          "promptType": "define",
          "text": "=Business: {{ $json.business_name }}\nSubject: {{ $json.subject }}\n\nTheir reply:\n\"\"\"\n{{ $json.reply_text }}\n\"\"\"",
          "hasOutputParser": true,
          "messages": {
            "messageValues": [
              {
                "message": "You sort replies to cold emails sent by a freelancer who builds AI automations for small businesses. Choose exactly one reply_type:\n- interested: wants to talk, asks a question about the service, asks for prices or details, or suggests a time.\n- not_interested: declines, already has a solution, or says no thanks.\n- out_of_office: an automatic away, holiday or auto-reply message.\n- unsubscribe: asks to stop emailing or to be removed, or is annoyed at being contacted.\n- other: anything else, such as the wrong person, a forward to a colleague, or an unclear message.\n\nExamples:\n\"Sounds interesting, what does it cost?\" = interested\n\"We are happy with our current setup, thanks.\" = not_interested\n\"I am out of the office until Monday with limited access to email.\" = out_of_office\n\"Please remove me from your list.\" = unsubscribe\n\"I have passed this to our practice manager.\" = other\n\nsummary: one short sentence on what they said. reasoning: one short sentence on why you chose the reply_type."
              }
            ]
          },
          "batching": {}
        },
        "id": "8a47ddd8-376a-44ae-b034-dff557407a9f",
        "name": "Classify Reply with AI",
