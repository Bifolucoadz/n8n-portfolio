      {
        "parameters": {
          "jsCode": "// Drop places already in the sheet (or repeated in this scrape) and map Apify fields to sheet columns.\nconst known = new Set($input.all().map(i => String(i.json.place_id ?? \"\")).filter(Boolean));\nconst isEmail = e => /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(e);\nconst seen = new Set();\nconst fresh = [];\n\nfor (const { json: p } of $(\"Scrape Google Maps (Apify)\").all()) {\n  const placeId = p.placeId;\n  if (!placeId || known.has(placeId) || seen.has(placeId)) continue;\n  seen.add(placeId);\n  const email = (p.emails ?? []).map(e => String(e).trim().toLowerCase()).find(isEmail) ?? \"\";\n  fresh.push({\n    json: {\n      place_id: placeId,\n      business_name: p.title ?? \"\",\n      category: p.categoryName ?? \"\",\n      address: p.address ?? \"\",\n      city: p.city ?? \"\",\n      phone: p.phone ?? \"\",\n      website: p.website ?? \"\",\n      email,\n      rating: typeof p.totalScore === \"number\" ? p.totalScore : null,\n      reviews: typeof p.reviewsCount === \"number\" ? p.reviewsCount : null,\n      maps_url: p.url ?? \"\",\n    },\n  });\n}\n\nreturn fresh;"
        },
        "id": "610d2f87-d4df-49a9-b466-14f54eee4d88",
        "name": "Keep New Places Only",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1200,
          304
        ]
      },
      {
        "parameters": {
          "promptType": "define",
          "text": "=Business: {{ $json.business_name }}\nCategory: {{ $json.category || \"unknown\" }}\nArea: {{ $json.city || $json.address || \"unknown\" }}\nGoogle rating: {{ $json.rating ?? \"none\" }} from {{ $json.reviews ?? 0 }} reviews\nWebsite: {{ $json.website || \"none\" }}\nEmail address found: {{ $json.email ? \"yes\" : \"no\" }}\nPhone listed: {{ $json.phone ? \"yes\" : \"no\" }}\n\nThe offer: {{ $(\"Config\").first().json.OFFER }}",
          "hasOutputParser": true,
          "messages": {
            "messageValues": [
              {
                "type": "SystemMessagePromptTemplate",
                "message": "You qualify local businesses as prospects for a freelancer who builds AI automations. Use only the listing data you are given and never invent facts.\n\nlead_score (1-10): how likely this business is to need and pay for the offer. Score higher when the business runs on enquiries and bookings (clinics, salons, trades, agencies, restaurants that take reservations), is busy (many reviews), is active online (has a website) and can be reached by email. Score lower for large chains and franchises with central IT, public bodies and charities, and listings with very few reviews and no website.\n\nscore_reason: one short sentence explaining the score.\n\npersonal_line: one natural sentence, max 25 words, that the freelancer could open a cold email with. Base it on something specific, true and positive from the listing, such as a strong rating, a high number of reviews, the specialty or the neighbourhood. Never mention a rating below 4.0 or a low number of reviews. Do not start with \"I noticed\" or \"I saw\". No flattery cliches and no exclamation marks."
              }
            ]
          },
          "batching": {
            "batchSize": 5,
            "delayBetweenBatches": 0
          }
        },
        "id": "94d031cd-de88-4ac1-b967-ed63402e2da1",
        "name": "Score Lead with AI",
        "type": "@n8n/n8n-nodes-langchain.chainLlm",
        "typeVersion": 1.9,
        "position": [
          1504,
          304
        ],
        "retryOnFail": true,
        "maxTries": 3,
        "waitBetweenTries": 5000,
        "onError": "continueRegularOutput"
      },
      {
        "parameters": {
          "schemaType": "manual",
          "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"lead_score\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 10, \"description\": \"Fit with the offer, 1 (poor) to 10 (ideal)\" },\n    \"score_reason\": { \"type\": \"string\", \"description\": \"One short sentence explaining the score\" },\n    \"personal_line\": { \"type\": \"string\", \"description\": \"One natural opening sentence for a cold email, max 25 words\" }\n  },\n  \"required\": [\"lead_score\", \"score_reason\", \"personal_line\"]\n}"
        },
